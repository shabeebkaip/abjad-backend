# Environment Variables for Vercel
MONGODB_URI=your-mongodb-connection-string
JWT_ACCESS_SECRET=your-access-secret
JWT_REFRESH_SECRET=your-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
OTP_EXPIRY_MINUTES=10
NODE_ENV=production

# LAUNCH BLOCKER — must be unset (or "false") before real production.
# When set to "true": disables ALL auth rate limiters (OTP send/verify,
# login, strict) AND the account-lockout logic (OTP 3-strike, password
# 5-strike) — works even under NODE_ENV=production. Temporary client
# rollout/testing override only. Prints a loud startup warning while set.
AUTH_THROTTLE_DISABLED=
CLIENT_URL=https://your-frontend-url.vercel.app
REDIS_URL=redis://your-redis-url
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880
